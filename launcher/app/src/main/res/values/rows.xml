<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <!-- ContentRow / TvRows row names. -->
    <string name="row_continue">Continue watching</string>
    <string name="row_movies">Movies</string>
    <string name="row_series">Series</string>
    <string name="row_animated_series">Animated series</string>
    <string name="row_cartoons">Cartoons</string>
    <string name="row_new_movies">New movies</string>

    <!-- Rows never shown, by the name on screen. -->
    <string-array name="hidden_rows" translatable="false">
        <item>Избранное</item>
    </string-array>

    <!-- Apps that show only their history and New movies (popular new films from ivi's catalogue, IviMovies).
         "=direct": open them as ivi links; "=tmdb": open their TMDB page in that app (NUM), only films with a known
         TMDB id; "=num": NUM's own New movies list instead of ivi's (NumReleases), the same films NUM shows;
         otherwise find the title in that app (AppSearch, LazyMedia). -->
    <string-array name="new_movies_apps" translatable="false">
        <item>ru.ivi.client=direct</item>
        <item>com.lazycatsoftware.lmd</item>
        <item>ru.yourok.num=num</item>
    </string-array>
    <!-- Any other movie app (Android's video category, or listed here) gets the same two rows: New movies (its own
         «Новинки»/«Премьеры» channel if it publishes one, else ivi's list found with the app's search) and its
         history. Known Russian apps that may not declare the video category: -->
    <string-array name="movie_apps" translatable="false">
        <item>ru.more.play</item>                 <!-- Okko -->
        <item>ru.kinopoisk</item>                 <!-- Кинопоиск -->
        <item>ru.kinopoisk.tv</item>
        <item>ru.start.androidmobile</item>       <!-- START -->
        <item>ru.start.tv</item>
        <item>ru.rt.video.app.tv</item>           <!-- Wink -->
        <item>gpm.premier.tv</item>               <!-- PREMIER -->
        <item>com.amediateka.tv</item>            <!-- Амедиатека -->
        <item>ru.kion.tv</item>                   <!-- KION -->
        <item>com.vk.tvvideo</item>               <!-- VK Видео -->
        <item>tv.okko.androidtv</item>
    </string-array>
    <!-- Apps that keep their own rows as they publish them (not movie catalogues). -->
    <string-array name="own_rows_apps" translatable="false">
        <item>com.google.android.youtube.tv</item>
        <item>org.videolan.vlc</item>
        <item>ru.yourok.torrserve</item>
    </string-array>

    <!-- NUM's New movies file (gzip JSON), the one NUM's own home reads. -->
    <string name="num_releases_url" translatable="false">https://releases.yourok.ru/releases/movies_id.json</string>

    <!-- AppSearch, per app: LazyMedia answers through its search provider (the one Android TV's global search uses) and
         opens the match in its article screen; NUM takes the title with ACTION_SEARCH in its details screen. -->
    <string name="search_lmd_authority" translatable="false">com.lazycatsoftware.lmd.tvsearch</string>
    <string name="search_lmd_activity" translatable="false">com.lazycatsoftware.lmd/com.lazycatsoftware.lazymediadeluxe.ui.tv.activities.ActivityTvArticle</string>
    <string name="search_num_activity" translatable="false">ru.yourok.num/ru.yourok.num.activity.details.DetailsActivity</string>

    <string name="search_finding">Looking for “%1$s” in %2$s…</string>
    <string name="search_not_found">Not found in %1$s, opening ivi</string>
</resources>
