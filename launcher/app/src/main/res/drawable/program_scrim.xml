<?xml version="1.0" encoding="utf-8"?>
<!-- Over the focused program's backdrop (content_row): dark on the left where the name and description are, and
     towards the bottom where the row and the dock are, so both stay readable over any poster. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="0" android:startColor="#F2000000" android:centerColor="#99000000"
                android:endColor="#1A000000" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#00000000" android:centerColor="#40000000"
                android:endColor="#F2000000" />
        </shape>
    </item>
</layer-list>
